APP_NAME=SCOM
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=scom_test
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true

CACHE_STORE=file
QUEUE_CONNECTION=sync

# Seeders demonstrativos: desabilitados por padrão.
SCOM_ALLOW_DEMO_SEEDERS=false
SCOM_DEMO_PASSWORD=

# IA local (Ollama) para leitura assistida de editais (revisao humana obrigatoria)
SCOM_AI_ENABLED=true
SCOM_AI_URL=http://127.0.0.1:11434
SCOM_AI_MODEL=qwen2.5:3b
SCOM_AI_TIMEOUT=60